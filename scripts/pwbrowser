#!/bin/bash
# pwbrowser —— 在桌面用户的会话里启动一个带 CDP 调试端口的 Chromium，
#              用的是他本人那个 profile（cookie / 登录态都在里面）。
#
# 幂等：CDP 已经活着就什么都不做。所以可以放心地当看门狗反复调用。
#
# 为什么绕这么一圈：
#   1. snap 应用不能由 root 直接 fork —— snap-confine 会拒绝，报
#      "is not a snap cgroup"。必须经由用户自己的 systemd 启动，
#      也就是桌面应用正常走的那条路。
#   2. 必须用目标用户身份跑，否则 root 会在他的 profile 里写一堆
#      root 属主的文件，之后他自己开浏览器就会写不进去。
#
# 用法:
#   pwbrowser                 # 就绪就跳过，没就绪就启动
#   pwbrowser --quiet         # 看门狗模式：无事发生就完全静默
#   PWB_CDP_PORT=9223 pwbrowser
#   PWB_DISPLAY=:11 pwbrowser # 手动指定显示
set -euo pipefail

TARGET_USER="${PWB_USER:-user}"
PORT="${PWB_CDP_PORT:-9222}"
PROFILE="${PWB_PROFILE:-/home/$TARGET_USER/snap/chromium/common/chromium}"
BROWSER="${PWB_BROWSER:-/snap/bin/chromium}"
UNIT="${PWB_UNIT:-pwbrowser}"
WAIT="${PWB_TIMEOUT:-40}"
XAUTH="${PWB_XAUTHORITY:-/home/$TARGET_USER/.Xauthority}"

# Chromium 启动参数（可覆盖）。
#
# ⚠️ 2026-09-14 实测记录（别再走弯路了）：
#   试过 --disable-gpu / --process-per-site / --js-flags，结果是**负优化**：
#     Chromium RSS 1114MB → 1563MB，多吃了 449MB。原因：
#       - --disable-gpu     Chromium 152 已废弃它，GPU 进程照样起（139MB），
#                           只是降级成软件渲染，反而更吃 CPU
#       - --process-per-site 反向：它按「站点数」常驻 renderer。只开 1 个
#                           标签时本来 1 个 renderer 就够，它却起了好几个
#   所以这里默认留空 —— 不自作主张。只在标签开很多时才考虑临时加。
#
# 想临加参数： PWB_FLAGS="--disk-cache-size=67108864" pwbrowser
DEFAULT_FLAGS=""
FLAGS="${PWB_FLAGS-$DEFAULT_FLAGS}"

QUIET=0
[ "${PWB_QUIET:-0}" = "1" ] && QUIET=1
[ "${1:-}" = "--quiet" ] && QUIET=1

say()  { [ "$QUIET" = "1" ] || echo "$@"; }
warn() { echo "$@" >&2; }

UID_TARGET="$(id -u "$TARGET_USER")"
RUNTIME_DIR="/run/user/$UID_TARGET"

as_user() {
    runuser -u "$TARGET_USER" -- \
        env XDG_RUNTIME_DIR="$RUNTIME_DIR" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNTIME_DIR/bus" \
        "$@"
}

cdp_up() { curl -sf -m 2 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; }

# 找出「目标用户真正在看的那块屏」。
#
# ⚠️ 千万别用「编号最大的 X socket」——那是上一版的写法，害惨过一次：
#    调试时手工起的一个 Xvfb :11 编号比真桌面 :10 大，于是看门狗把浏览器
#    启到了那个看不见的虚拟屏上；模型照样能操作（CDP 通），但用户屏幕上
#    什么都没有，表现为「我看到的和模型操作的不是一个」。
#
# 优先级：
#   1. logind 里该用户「活跃的 x11 会话」的 Display 字段 —— 最权威
#   2. 窗口管理器进程（kwin/plasmashell/openbox）的 DISPLAY —— 有 WM 才是真桌面
#   3. 兜底：编号最大的 socket（老行为，只在上面两条都问不出来时用）
detect_display() {
    local s d typ

    for s in $(loginctl list-sessions --no-pager 2>/dev/null \
               | awk -v u="$TARGET_USER" '$3==u {print $1}'); do
        typ=$(loginctl show-session "$s" -p Type --value 2>/dev/null)
        [ "$typ" = "x11" ] || continue
        d=$(loginctl show-session "$s" -p Display --value 2>/dev/null)
        case "$d" in
            ""|"-"|" ") continue ;;
        esac
        printf '%s' "$d"
        return
    done

    local p
    for p in $(pgrep -u "$TARGET_USER" -x kwin_x11 2>/dev/null) \
             $(pgrep -u "$TARGET_USER" -x plasmashell 2>/dev/null) \
             $(pgrep -u "$TARGET_USER" -x openbox 2>/dev/null) \
             $(pgrep -u "$TARGET_USER" -x xfwm4 2>/dev/null); do
        d=$(tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | sed -n 's/^DISPLAY=//p')
        [ -n "$d" ] && { printf '%s' "$d"; return; }
    done

    local best="" n owner
    for s in /tmp/.X11-unix/X*; do
        [ -e "$s" ] || continue
        owner="$(stat -c '%U' "$s" 2>/dev/null)" || continue
        [ "$owner" = "$TARGET_USER" ] || continue
        n="${s##*X}"
        best=":$n"
    done
    printf '%s' "$best"
}

if cdp_up; then
    say "[=] CDP 已经在 http://127.0.0.1:$PORT 上跑着，不重复启动"
    exit 0
fi

DISPLAY_NUM="${PWB_DISPLAY:-$(detect_display)}"
if [ -z "$DISPLAY_NUM" ]; then
    # 桌面没起来。看门狗模式下静默退出 —— 敲过 xiaji 之后
    # 这里每 60 秒吵一次没有意义。
    warn "[-] 找不到 $TARGET_USER 的 X 显示。"
    warn "    先敲 shangji 起桌面，并且至少用 RDP 连进去一次。"
    [ "$QUIET" = "1" ] && exit 0
    exit 1
fi

# Chromium 是单实例的：如果已经开着一个（没带调试端口），我们再启一个
# 同 profile 的，新进程只会把参数转发给老进程然后自己退出 —— 端口永远不会开。
#
# 两种处置方式（PWB_FORCE 控制）：
#   默认（温和）：不杀，直接报错退出。你手动开的窗口原封不动，数据不会丢。
#                代价：端口起不来，模型连不上，得你自己关掉那个窗口再敲一次。
#                看门狗会每分钟重试，一旦你关掉窗口它就会自动拉起带端口的那个。
#   PWB_FORCE=1：杀掉重开。模型马上能用，但没提交的表单会丢。
#                "我很确定那个 Chromium 没用，随便关"的时候用。
FORCE="${PWB_FORCE:-0}"
if pgrep -u "$TARGET_USER" -f 'snap/chromium/.*chromium-browser/chrome' >/dev/null 2>&1; then
    if [ "$FORCE" = "1" ]; then
        say "[!] $TARGET_USER 已开着一个无调试端口的 Chromium，PWB_FORCE=1 → 关掉重开"
        as_user systemctl --user stop "$UNIT.service" >/dev/null 2>&1 || true
        pkill -u "$TARGET_USER" -f 'snap/chromium/.*chromium-browser/chrome' >/dev/null 2>&1 || true
        sleep 3
        pkill -9 -u "$TARGET_USER" -f 'snap/chromium/.*chromium-browser/chrome' >/dev/null 2>&1 || true
        sleep 1
    else
        warn "[!] $TARGET_USER 已开着一个 Chromium，但它没带调试端口。"
        warn "    它占着 profile 锁，新的带端口实例起不来，模型连不上。"
        warn "    我不会擅自杀掉它（怕丢你没提交的表单）。你二选一："
        warn "      a) 自己关掉那个 Chromium 窗口，等看门狗自动拉起带端口的"
        warn "      b) 敲： PWB_FORCE=1 pwbrowser   （我帮你关掉重开）"
        [ "$QUIET" = "1" ] && exit 0
        exit 2
    fi
fi

say "[*] 在 $DISPLAY_NUM 上启动 Chromium"
say "    用户: $TARGET_USER    profile: $PROFILE    CDP: 127.0.0.1:$PORT"

as_user systemd-run --user --collect --unit="$UNIT" \
    --setenv=DISPLAY="$DISPLAY_NUM" \
    --setenv=XAUTHORITY="$XAUTH" \
    --setenv=HOME="/home/$TARGET_USER" \
    "$BROWSER" \
        --remote-debugging-port="$PORT" \
        --user-data-dir="$PROFILE" \
        --no-first-run \
        --no-default-browser-check \
        $FLAGS \
    >/dev/null

for _ in $(seq 1 "$WAIT"); do
    if cdp_up; then
        say "[+] 就绪：CDP 在 http://127.0.0.1:$PORT（显示 $DISPLAY_NUM，用户 $TARGET_USER）"
        exit 0
    fi
    sleep 1
done

warn "[-] 等了 $WAIT 秒没等到 CDP 端点。看日志："
as_user journalctl --user -u "$UNIT" -n 20 --no-pager >&2 2>/dev/null || true
exit 1
